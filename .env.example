POSTGRES_DB=server_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change_me_generate_a_strong_password
SECRET_KEY=change_me_generate_with_openssl_rand_-hex_32

# Where the DB (postgres/) and uploaded variant/item files (uploads/) live
# on the host — bind mounts, not anonymous Docker volumes, so backups and
# disk-usage monitoring have a real, predictable path. Absolute path
# recommended in production (e.g. /srv/server-tracker/data); relative path
# resolves against the directory docker compose is run from.
DATA_DIR=./data

# NOTE: the JSON API for agents and scripts is not configured here. Its tokens
# live in the database and are issued at /api-tokens (see README.md → «JSON
# API»), so there is nothing to set and nothing to restart. With no tokens
# issued, the API is closed. The old API_TOKEN/API_SERVICE_USERNAME variables
# are no longer read and can be deleted from an existing .env.

# Where scripts/backup.sh writes DB dumps and uploads archives, and how
# many of each to keep (see scripts/backup.sh — oldest beyond this count
# are deleted on every run).
BACKUP_DIR=./backups
BACKUP_RETENTION=10
